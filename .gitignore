# .gitignore for ParkSmart
# -------------------------
# Files and folders Git should NOT upload to GitHub

# ── Virtual environment ──
venv/
env/
.env

# ── Database (contains real data, regenerated by init_db.py) ──
database/parking.db

# ── Uploaded camera images (runtime files) ──
static/uploads/*
!static/uploads/.gitkeep

# ── EasyOCR downloaded models (very large, ~200MB) ──
.EasyOCR/

# ── Python cache files ──
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── VS Code settings ──
.vscode/

# ── Windows system files ──
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Mac system files ──
.DS_Store
.AppleDouble

# ── Logs ──
*.log
logs/

# ── Environment variables file ──
.env
.env.local

# ── Pytest cache ──
.pytest_cache/
htmlcov/
.coverage